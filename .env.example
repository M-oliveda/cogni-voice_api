# SPDX-License-Identifier: GPL-2.0-or-later
#
# Create .env (git-ignored) with `make env`, which copies this file and fills in
# freshly generated local secrets. Every variable is described in README.md
# ("Environment Variables") and MASTERPLAN.md §12.2. Never commit real secrets;
# in CI and the cloud they come from GitHub Secrets.

# --- Application -------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (secrets) ------------------------------------------------------
DATABASE_URL=
DATABASE_MIGRATION_URL=
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_ECHO=false

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# --- API keys ----------------------------------------------------------------
API_KEY_HMAC_SECRET=

# --- AI providers (gemini, ollama, or fake; fake only in local) --------------
AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
MAX_INTERACTION_CHARS=1000

# --- Task queue (db locally, cloud_tasks in the cloud) -----------------------
TASK_QUEUE_BACKEND=db
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_INVOKER_SA=
SERVICE_URL=

# --- Agent guardrails (AGENT_MAX_STEPS: 6 on Gemini, 4 on Ollama) -------------
AGENT_MAX_STEPS=4
AGENT_MAX_TOKENS=8000
AGENT_TIMEOUT_SECONDS=60

# --- Demo --------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_TENANT_ID=

# --- Observability and retention ---------------------------------------------
TRACING_ENABLED=false
AGENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# --- Local Supabase services (docker-compose.yaml only, never in the cloud) --
POSTGRES_PASSWORD=
COGNIVOICE_APP_DB_PASSWORD=
SUPABASE_ANON_KEY=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
PG_META_CRYPTO_KEY=
# Ollama URL seen from the api and worker containers (default: the host)
COMPOSE_OLLAMA_URL=
